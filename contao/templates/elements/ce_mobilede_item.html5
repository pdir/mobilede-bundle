<?php if($this->desc == ''): return ''; endif; ?>
<a href="<?= $this->link ?>" class="item md-ad-box <?= $this->filterClasses ?><?php if($this->onlyFilter): ?> hidden<?php endif; ?>" data-price="<?= $this->plainPrice ?>" data-power="<?= $this->plainPower ?>" data-mileage="<?= str_replace(",","",$this->mileage) ?>" data-acc="<?= $this->account ?>">
<?php if(!$this->onlyFilter): ?>
<div class="image">
  <?php if($this->image): ?>
    <?php $this->insert('image', $this->arrData); ?>
  <?php elseif($this->imageSrc_L): ?>
    <picture>
      <img src="<?= $this->imageSrc_L ?>" srcset="<?= $this->imageSrc_L ?> 1x, <?= $this->imageSrc_XL ?> 1.5x, <?= $this->imageSrc_XXL ?> 2x"  alt="<?= $this->desc ?>" loading="lazy">
    </picture>
  <?php else: ?>
  <picture>
    <img src="bundles/pdirmobilede/img/fahrzeugmanager_platzhalter.jpg" srcset="bundles/pdirmobilede/img/fahrzeugmanager_platzhalter.jpg 1x, bundles/pdirmobilede/img/fahrzeugmanager_platzhalter.jpg 1.5x, bundles/pdirmobilede/img/fahrzeugmanager_platzhalter.jpg 2x"  alt="Fahrzeug Platzhalter">
  </picture>
  <?php endif; ?>
</div>
<div class="price">
  <?php if($this->showGrossPrice): ?>
  <span class="gross-price">
        <?= $this->price ?>
    <?php if(isset($this->pseudoPrice)): ?><span class="pseudo-price"><?= $this->pseudoPrice ?></span><?php endif; ?>
    <span class="price-label"> <?= $this->priceLabel ?></span></span>
  <?php endif; ?>

  <?php if($this->showNetPrice): ?>
  <span class="net-price"><?= $this->netPrice ?><span class="price-label"> <?= $this->netPriceLabel ?></span></span>
  <?php endif; ?>
</div>
<div class="detail">
  <!-- Header -->
  <header class="clearfix">

    <h5 class="title">
      <?= $this->desc ?>
    </h5>
    <ul class="custom-list">
      <?php if($this->power): ?>
      <li>
        <i class="icon-gauge"></i><?= $this->power ?>
      </li>
      <?php endif; ?>
      <?php if($this->fuelType): ?>
      <li>
        <?= $this->fuelType ?>
      </li>
      <?php endif; ?>
      <?php if($this->transmission): ?>
      <li class="last">
        <?= $this->transmission ?>
      </li>
      <?php endif; ?>
    </ul>
  </header>
  <!-- Fuel and type -->
  <p>
    <?php if(!empty($this->emissionValues)): ?>
      <div class="emission fields">
        <?php foreach($this->emissionValues as $emissionValue): ?>
          <span>
            <?php if (isset($emissionValue['label'])): ?><span class="label"><?= $emissionValue['label'] ?></span><?php endif; ?>
            <?php if (isset($emissionValue['value'])): ?><span class="value"><?= $emissionValue['value'] ?></span><?php endif; ?>
            <?php if (isset($emissionValue['unit'])): ?><span class="unit"><?= $emissionValue['unit'] ?></span><?php endif; ?>
          </span>
        <?php endforeach; ?>
      </div>
    <?php endif; ?>

    <?php if(!empty($this->fuelConsumptions)): ?>
      <ul class="consumptions fields">
        <li>
          <span class="label"><?= $this->fuelConsumptionLabel ?>: </span>
          <span class="value">
            <?php foreach($this->fuelConsumptions as $consumption): ?>
              <span><?= $consumption['value'] ?> (<?= $consumption['label'] ?>)</span>
            <?php endforeach; ?>
          </span>
        </li>
      </ul>
    <?php endif; ?>

    <?php if(!empty($this->powerConsumptions)): ?>
      <ul class="consumptions fields">
        <li>
          <span class="label"><?= $this->powerConsumptionLabel ?>: </span>
          <span class="value">
            <?php foreach($this->powerConsumptions as $consumption): ?>
              <span><?= $consumption['value'] ?> (<?= $consumption['label'] ?>)</span>
            <?php endforeach; ?>
          </span>
        </li>
      </ul>
    <?php endif; ?>
  </p>
  <!-- Features List -->
  <div class="features-area">
    <ul class="features-list clearfix">
      <li>
        <i class="icon-calendar-times-o"></i>
        <span><?= $this->firstRegistration ?></span>
      </li>
      <li>
        <i class="icon-road"></i>
        <span><?= $this->mileage ?><?php #= number_format($this->mileage, 2, "," ,".") ?> km</span>
      </li>
    </ul>
  </div>

  <div class="md-ad-box-overlap-wrapper">
    <h2><?= $this->desc ?></h2>

    <div class="md-ad-box-overlap-btns-area">
      <div class="overlap-btn"><i class="icon-picture"></i></div>
    </div>
  </div>
</div>

<?php endif; ?>
</a>
<!-- mobilede ad box end-->