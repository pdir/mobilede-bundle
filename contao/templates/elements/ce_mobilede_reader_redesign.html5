            <?= $this->ad['seller']['address']['zipcode'] ?> <?= $this->ad['seller']['address']['city'] ?></p>

            <?php if (isset($this->ad['seller']['phones']) && is_array($this->ad['seller']['phones'])): ?>
              <?php foreach($this->ad['seller']['phones'] as $phone): ?>
                <?php
                // Zusammensetzen der Telefonnummer
                $formatted = '+' . $phone['internationalPrefix'] . ' ' . $phone['nationalPrefix'] . ' ' . $phone['number'];
                // Für tel:-Link nur Zahlen und + verwenden
                $tel = '+' . $phone['internationalPrefix'] . $phone['nationalPrefix'] . $phone['number'];
                ?>
                <i class="icon-phone" title="Telefon"></i>
                <a href="tel:<?= $tel ?>"><?= $formatted ?></a><br>
              <?php endforeach; ?>
            <?php endif; ?>

            <p>
              <?php if(isset($this->ad['seller']['email'])): ?>
                <i class="icon-mail" title="E-Mail"></i> {{email::<?= $this->ad['seller']['email'] ?>}}<br>
              <?php endif; ?>

              <?php if(isset($this->ad['seller']['homepage'])): ?>
                <i class="icon-globe" title="Web"></i>
