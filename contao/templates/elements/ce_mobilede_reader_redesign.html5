                  </div>

                  <div class="energy-label-new__class energy-label-new__class--g">
                    <span>G</span>
                  </div>
                </div>

                <div class="energy-label-new__results<?php if (isset($classDischarged)): ?> with-discharged-class<?php endif; ?>">
                  <div class="energy-label-new__result">
                    <div class="energy-label-new__title">
                      <?= preg_match('/\((.*?)\)/', $this->ad['emissionValues']['co2_class']['label'], $m) ? $m[1] : '' ?>
                    </div>

                    <div class="energy-label-new__indicator class-<?= strtolower($class) ?>">
                      <?= $class ?>
                    </div>
                  </div>

                  <?php if (isset($classDischarged)): ?>
                    <div class="energy-label-new__divider"></div>

                    <div class="energy-label-new__result">
                      <div class="energy-label-new__title">
                        <?= preg_match('/\((.*?)\)/', $this->ad['emissionValues']['co2_class_discharged']['label'], $m) ? $m[1] : '' ?>
                      </div>

                      <div class="energy-label-new__indicator class-<?= strtolower($classDischarged) ?>">
                        <?= $classDischarged ?>
                      </div>
                    </div>
                  <?php endif; ?>
                </div>
              </div>
            </div>
          </div>
        <?php endif; ?>

        <h2><?= $GLOBALS['TL_LANG']['pdirMobileDe']['field_keys']['headline-features'] ?></h2>
        <div class="md-detail-box additional-attributes features">
