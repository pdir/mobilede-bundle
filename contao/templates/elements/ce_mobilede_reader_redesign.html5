              <?php endif; ?>

              <?php if(isset($this->ad['seller']['mobileSellerSince'])): ?>
                <p><?= $GLOBALS['TL_LANG']['pdirMobileDe']['field_keys']['seller-since'] ?> <?= date($GLOBALS['TL_CONFIG']['dateFormat'] ,strtotime($this->ad['seller']['mobileSellerSince'])) ?></p>
              <?php endif; ?>
            </p>
          </div>
        <?php endif; ?>

        <?php if ($this->form): ?>
        <div class="md-detail-box additional-form">
          <h2><?= $GLOBALS['TL_LANG']['pdirMobileDe']['field_keys']['headline-contact-form'] ?></h2>
          {{insert_form::<?= $this->form ?>}}
        </div>
        <?php endif; ?>
      </div>
